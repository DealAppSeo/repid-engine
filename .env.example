# === Required ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
REPID_API_KEYS=comma-separated-api-keys

# === LLM Providers (at least one required) ===
GROQ_API_KEY=your-groq-key
ANTHROPIC_API_KEY=your-anthropic-key
GOOGLE_AI_KEY=your-google-key

# === Optional ===
HAL_STRICTNESS=1                    # 1=extractor only, 2=cross-LLM fact-check
WRITER_DIRECT_APPLY=true            # true=immediate RepID updates, false=aggregator
PORT=3000
NODE_ENV=production
TELEGRAM_BOT_TOKEN=your-bot-token   # for HITL notifications
