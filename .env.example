SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PORT=3000
REPID_ENGINE_VERSION=1.0.0
NODE_ENV=development

# HAL strict mode: when 'true', silent degradations become loud failures.
# Set true for measurement runs, leave false in prod.
HAL_STRICT_MODE=false

# --- SELF-HOST / DATA-LOCAL (all default-OFF; hosted behavior unchanged) ------
# See SELFHOST.md. Entry: node dist/selfhost.js (NOT dist/index.js).
# LOCAL_MODE: boot without a hosted Supabase (loopback default instead of throw).
LOCAL_MODE=false
# ONLY_ATTESTATIONS_LEAVE: prompt/response TEXT may not egress to a non-local
# host; proofs / EAS anchors / chain writes still may.
ONLY_ATTESTATIONS_LEAVE=false
# LOCAL_LLM_BASE_URL: OpenAI-compatible base URL for the HAL quorum (Ollama/vLLM).
# e.g. http://localhost:11434/v1 . Empty = cloud endpoints unchanged.
LOCAL_LLM_BASE_URL=
