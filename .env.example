SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PORT=3000
REPID_ENGINE_VERSION=1.0.0
NODE_ENV=development

# Buyer wallet (Sean funds with USDC from Circle faucet)
BUYER_PRIVATE_KEY=0x... # for wallet 0xdf6b8215...271d

# Spokesperson signing keys — Sean exports from MetaMask
SHOFET_SIGNING_KEY=0x... # for wallet 0x15eB9A...b052
VERITAS_SIGNING_KEY=0x... # for wallet 0x2832eB...e9b9
APM_SIGNING_KEY=0x... # for wallet 0xceD17F...199C
SOPHIA_SIGNING_KEY=0x... # for wallet 0x7b84CC...3261

# Optional: triad-member keys (not needed for Tracks 3-7 but future-ready)
# ORCH_SIGNING_KEY=0x...
# W3C_SIGNING_KEY=0x...
# (etc)

SIGNING_FALLBACK_MODE=deployer
