# fly.secrets.template — PLACEHOLDER NAMES ONLY. NO VALUES. NEVER fill this in and commit it.
# Usage [SEAN]: copy to a LOCAL untracked file, fill values from Railway (never logged), then:
#   flyctl secrets import < fly.secrets.local    # imports KEY=VALUE pairs into Fly secret store
# This template is committed; a *filled* version must NEVER be committed (.gitignore + .dockerignore
# exclude *.env / *secret* / *.key; keep the filled copy outside the repo or as fly.secrets.local).
#
# See deploy/ENV_MANIFEST.md for the secret/non-secret classification and which surface needs each.

# --- REQUIRED AT BOOT ---
SUPABASE_URL=__SET_IN_HOST__
SUPABASE_SERVICE_ROLE_KEY=__SET_IN_HOST__

# --- AUTH ---
REPID_API_KEYS=__SET_IN_HOST__

# --- DB DIRECT (if hot-path pg / proof-drain used) ---
DATABASE_URL=__SET_IN_HOST__

# --- ON-CHAIN (only if standby runs writers; omit for read-mostly warm standby) ---
ERC8004_OPERATOR_KEY=__SET_IN_HOST__
ERC8004_REPUTATION_WRITER_KEY=__SET_IN_HOST__
BASE_SEPOLIA_PRIVATE_KEY=__SET_IN_HOST__
EAS_ATTESTER_PRIVATE_KEY=__SET_IN_HOST__
HYPERDAG_ATTESTOR_PRIVATE_KEY=__SET_IN_HOST__
DEPLOYER_PRIVATE_KEY=__SET_IN_HOST__

# --- LLM PROVIDERS (set the subset the live HAL provider list resolves) ---
ANTHROPIC_API_KEY=__SET_IN_HOST__
OPENAI_API_KEY=__SET_IN_HOST__
GROQ_API_KEY=__SET_IN_HOST__
CEREBRAS_API_KEY=__SET_IN_HOST__
DEEPSEEK_API_KEY=__SET_IN_HOST__
GEMINI_API_KEY=__SET_IN_HOST__
GROK_API_KEY=__SET_IN_HOST__
MISTRAL_API_KEY=__SET_IN_HOST__
FIREWORKS_API_KEY=__SET_IN_HOST__

# Non-secret feature flags can be set in fly.toml [env] instead of secrets:
