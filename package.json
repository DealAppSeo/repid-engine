    "probe:repid": "ts-node scripts/liveness-probes/probe-repid-scoring.ts",
    "repid:sync": "ts-node src/services/reputation/repid-sync-aggregator.ts --dry-run",
    "repid:sync:apply": "REPIDSYNC_APPLY=true ts-node src/services/reputation/repid-sync-aggregator.ts --apply",
    "probe:graph-rag": "ts-node scripts/liveness-probes/probe-graph-rag.ts",
    "probe:x402": "ts-node scripts/liveness-probes/probe-x402-settlements.ts",
    "probe:onchain": "ts-node scripts/liveness-probes/probe-onchain-reputation.ts",
    "probe:trinity": "ts-node scripts/liveness-probes/probe-trinity-swarm.ts",
    "probe:anfis": "ts-node scripts/liveness-probes/probe-anfis-routing.ts",
    "capture:baseline": "ts-node scripts/capture-baseline.ts",
    "capture:post-wakeup": "ts-node scripts/capture-post-wakeup.ts",
    "mock:scenario-01": "ts-node scripts/mock-harness/scenarios/scenario-01-constitutional-refuser.ts",
    "mock:scenario-02": "ts-node scripts/mock-harness/scenarios/scenario-02-aggressive-trader.ts",
    "mock:scenario-03": "ts-node scripts/mock-harness/scenarios/scenario-03-hallucinator.ts",
    "mock:scenario-04": "ts-node scripts/mock-harness/scenarios/scenario-04-trading-pair.ts",
    "mock:exercise-anfis": "ts-node scripts/mock-harness/exercise-anfis.ts",
    "mock:exercise-graph-rag": "ts-node scripts/mock-harness/exercise-graph-rag.ts",
    "demo:full-loop": "ts-node scripts/mock-harness/full-loop-demo.ts",
    "demo:full-loop:real": "ts-node -e \"process.env.MOCK_FACILITATOR='false';require('./scripts/mock-harness/full-loop-demo.ts')\"",
    "cb:kill": "ts-node scripts/circuit-breaker-controls.ts kill",
    "cb:resume": "ts-node scripts/circuit-breaker-controls.ts resume",
    "cb:status": "ts-node scripts/circuit-breaker-controls.ts status",
    "graph-rag:infer-edges": "ts-node scripts/graph-rag/infer-edges.ts",
    "graph-rag:backfill-embeddings": "ts-node scripts/graph-rag/backfill-embeddings.ts",
    "corpus:hash": "node scripts/corpus/hash-corpus.mjs",
    "corpus:migrate": "node scripts/corpus/migrate-to-v1-schema.mjs",
    "corpus:verify": "jest --config jest.config.js tests/corpus-files.test.ts",
    "hal:seed-ground-truth": "ts-node scripts/hal/seed-ground-truth.ts",
    "hal:score-external": "ts-node tests/hal/score-corpus.ts",
    "hal:ground-truth-stats": "ts-node scripts/hal/seed-ground-truth.ts --stats",
    "hal:ground-truth-template": "ts-node scripts/hal/seed-ground-truth.ts --export-template ./hal-ground-truth-template.csv",
    "hal:reskin": "ts-node scripts/hal-eval/reskin-invariance.ts",
    "types:gen": "npx supabase gen types typescript --project-id qnnpjhlxljtqyigedwkb --schema public > src/types/database.types.ts",
    "types:check": "tsc --noEmit",
    "x402:preflight-real-microtx": "tsx scripts/x402/preflight-real-microtx.ts",
    "demo:trust": "node scripts/demo/trust-receipt.mjs",
    "demo:own-agent": "node scripts/demo/own-your-agent.mjs",
    "demo:harness": "node scripts/demo/trust-harness-e2e.mjs",
    "ops:reconcile": "ts-node scripts/ops/reconcile-settlements.ts",
    "repid:decay": "ts-node scripts/run-repid-decay.ts",
    "repid:decay:apply": "ts-node scripts/run-repid-decay.ts --apply"
  },
  "keywords": [],
