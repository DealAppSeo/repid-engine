{
  "name": "repid-engine",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prepublishOnly": "node -e \"console.error('repid-engine is proprietary and must NEVER be published to npm (it contains the scoring formula, a hard-stop secret). Refusing. Publish a clean public wrapper instead.'); process.exit(1)\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --config jest.config.js --forceExit",
    "test:regression": "jest --config jest.config.js tests/regression",
    "heartbeat": "ts-node scripts/heartbeat/run-heartbeat.ts",
    "audit-probe": "ts-node scripts/audit-probe/run-audit-probe.ts",
    "capture:telemetry": "ts-node scripts/observability/capture-telemetry.ts --family all",
    "health:24h": "ts-node scripts/observability/health-summary-24h.ts",
    "verify:alpaca": "ts-node scripts/verify/alpaca-paper-flow.ts",
    "verify:crosscheck": "ts-node scripts/verify/crosscheck.ts",
    "verify:claims": "ts-node scripts/verify/claims.ts",
    "verify:deployed-sha": "ts-node scripts/verify/assert-deployed-sha.ts",
    "test:e2e": "jest --config tests/e2e/jest.e2e.config.js --runInBand --forceExit",
    "smoke:hal-external": "ts-node scripts/external-caller-smoke-test.ts",
    "smoke:prod": "tsx scripts/production-smoke.ts",
    "indexer": "node dist/scripts/start-indexer-service.js",
    "worker": "node dist/scripts/start-proof-drain-service.js",
    "smoke:graph-rag": "ts-node scripts/graph-rag-smoke.ts",
    "backfill:erc8004:headline-4": "ts-node scripts/erc8004-backfill-headline-4.ts",
    "backfill:erc8004:mass": "ts-node scripts/erc8004-backfill-mass-19plus1.ts",
    "reputation:backfill:spokespersons": "ts-node scripts/erc8004-reputation-backfill-spokespersons.ts",
    "probe:reputation": "ts-node scripts/erc8004-reputation-probe.ts",
    "x402:health": "tsx scripts/x402-health.ts",
    "x402:recovery-worker": "tsx scripts/x402/run-recovery-worker.ts",
    "install:hooks": "ts-node scripts/install-hooks.ts",
    "guard:prod-fixtures": "node scripts/hooks/prod-fixture-guard.js --ci",
    "worktree:doctor": "ts-node scripts/git-worktree/doctor.ts",
    "verify:hal-dual-write": "ts-node scripts/verify-hal-dual-write.ts",
    "test:integration": "jest --config jest.integration.config.js --runInBand --forceExit",
    "smoke:full": "npm run smoke:prod && npm run test:integration",
    "probe:all": "ts-node scripts/liveness-probes/run-all-probes.ts",
