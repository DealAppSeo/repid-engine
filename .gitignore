node_modules/
dist/
.env
.env.local
.env*.local
.firecrawl/
*.js.map
.DS_Store
.claude/worktrees/
# CodeGraph local index (52MB SQLite of the whole tree). The tool ships its own
# .codegraph/.gitignore, but this repo is PUBLIC — pin it here too so a `git add -A`
# can never stage a full structural map of the codebase.
.codegraph/

# HAL eval RAW run logs. Regenerable, large, and — the reason this rule exists —
# provider 429 bodies embed our Groq ORGANIZATION ID in plain text (verified
# 2026-08-09: 23 of 31 log files carried it). This repo is PUBLIC. Commit the
# derived `_*.txt` summaries instead; they carry the numbers without the identifiers.
reports/hal-eval/*.log
# Aborted runs: coverage below floor, f1 null. Not results — transport failures.
reports/hal-eval/*.INCOMPLETE.json

# Agent scratch scripts written into the repo ROOT. This is not hypothetical:
# `_scratch-dpb.mjs` appeared here on 2026-08-09 carrying .env.master loading,
# BASE_SEPOLIA_PRIVATE_KEY use, live x402 signing, production service UUIDs and
# wallet addresses. `git add -A` would have published all of it (CLAUDE_RULES 25 —
# the same class as the credential scratch files staged on 2026-08-01).
/_scratch-*
/scratch-*.mjs
/scratch-*.ts

# Generated artifacts (regenerable via npm scripts)
hal-ground-truth-template.csv
.env.local
.firecrawl/
verify-crosscheck-report.json

# Secrets — never commit (dispatch hardening 2026-06-28, XC fix #5)
service_role.txt
railway_vars*.txt
*.key
*-key.txt
.sb-service-key
.telegram-*
scripts/dispatch/.dispatch.env

# Local dev sprawl — never commit (secret-hygiene 2026-07-15)
scratch/
terminals/
mcps/
__pycache__/
.env.master
railway_env.json
.env.railway
# WS2.3 RRL shadow ledger (regenerated by scripts/rrl/shadow-replay.ts; sample committed)
reports/2026-07-18/rrl-shadow-ledger.jsonl
.env.e2e.local
.env.canary.local

# Delegated-agent scratch files. A free agent investigating the DB wrote
# credential-bearing dumps into the repo root on 2026-08-01; gitleaks caught
# them at commit. Ignore by pattern so the next one cannot be staged by accident.
scratch_*.js
scratch_*.json
db_raw_results.json
pvq_results.json
.claude/settings.local.json

# One-off agent scratch at the repo root. Every one of these that has ever existed
# carried a live credential inline (2026-08-03: 3 held a service_role JWT for
# Trinity prod, 9 held the anon key). Ignoring the pattern is the only thing that
# survives the next agent running `git add -A`.
/fix_db.js
/get_*.js
/get_impl.ts
/run_*.js
/run_*.ps1
/seed_*.js
/temp_*.js

# THE .ts GAP IN THE RULES ABOVE (closed 2026-08-04).
# The patterns above cover scratch_*.js / scratch_*.json / run_*.js — but NOT the
# TypeScript equivalents. This repo is a TypeScript project, so every one-off an
# agent or a human actually wrote landed as .ts and slipped straight past them:
# 82 unreferenced one-off scripts, logs and dumps had accumulated in the ROOT of a
# repo that is PUBLIC. Verified before removal — that batch held no credentials
# (0 hardcoded project ids, 0 JWT-shaped literals, 24/38 read process.env), so it
# was hygiene debt rather than an incident. The earlier batches this file already
# describes were not so lucky, which is the reason to close the gap now.
#
# Root-scoped (leading /) on purpose: src/check-*.ts and similar are legitimate
# module names and must stay tracked.
/scratch_*
/check_*.ts
/check-*.ts
/force_deposit*
/find_*.ts
/fetch_*.ts
/test_*.ts
/test-*.ts
/verify*.ts
/verify*.js
/run_*.ts
/step[0-9]*.ts
/backfill_*.ts
# Logs and terminal dumps: never belong in a repo, least of all a public one.
/*.log
/push_*.txt
/pull_*.txt
/all_ts_files.txt
# Railway variable dumps. The one removed on 2026-08-04 held NO secret values, but
# it did publish internal service topology and a private domain. It was UTF-16, so
# a naive grep scan reported it clean — check the encoding before trusting a scan.
/railway_vars.txt
/railway_env.json
